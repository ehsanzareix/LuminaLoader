{
  "name": "lumina-loader-svelte",
  "version": "0.0.3",
  "description": "Svelte adapter for Lumina Loader",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": ["**/*.css"],
  "scripts": {
    "build": "tsup --config tsup.config.ts --out-dir dist",
    "test": "vitest",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "keywords": [
    "loader",
    "lumina",
    "svelte"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "svelte": ">=4"
  },
  "dependencies": {
    "lumina-loader": "^1.1.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ehsanzareix/LuminaLoader.git",
    "directory": "packages/svelte"
  },
  "license": "MIT"
}

{
  "name": "lumina-loader-vue",
  "version": "0.0.3",
  "description": "Vue adapter for Lumina Loader",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts --out-dir dist && node scripts/copy-to-dist.js",
    "test": "vitest",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "vue": ">=3.3"
  },
  "dependencies": {
    "lumina-loader": "^1.1.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ehsanzareix/LuminaLoader.git",
    "directory": "packages/vue"
  },
  "license": "MIT"
}

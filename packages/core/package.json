{
  "name": "lumina-loader",
  "version": "1.1.3",
  "description": "Lumina core runtime (extracted)",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --out-dir dist",
    "test": "vitest",
    "prepack": "npm run build"
  },
  "keywords": [
    "loader",
    "lumina"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ehsanzareix/LuminaLoader.git",
    "directory": "packages/core"
  },
  "license": "MIT"
}

{
  "name": "lumina-loader-react",
  "version": "0.0.2",
  "description": "React adapter for Lumina Loader",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": ["**/*.css"],
  "scripts": {
    "build": "tsup src/index.tsx --format cjs,esm --dts --out-dir dist",
    "test": "vitest",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ehsanzareix/LuminaLoader.git",
    "directory": "packages/react"
  },
  "license": "MIT"
}
